// Prisma Schema for Unified POS & Inventory Management Platform
// Complies strictly with PRD v0.2: Tenant isolation, Decimal precision, Immutable bill snapshots, Stock movements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id              String          @id @default(uuid())
  name            String
  address         String?
  phone           String?
  currency        String          @default("₹")
  taxPercentage   Decimal         @default(0.0) @map("tax_percentage") @db.Decimal(5, 2)
  receiptHeader   String?         @map("receipt_header")
  receiptFooter   String?         @map("receipt_footer")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  users           User[]
  products        Product[]
  bills           Bill[]
  stockMovements  StockMovement[]
  lowStockAlerts  LowStockAlert[]
  expenses        Expense[]

  @@map("shops")
}

model User {
  id              String          @id @default(uuid())
  shopId          String          @map("shop_id")
  fullName        String          @map("full_name")
  username        String          @unique
  passwordHash    String          @map("password_hash")
  isOwner         Boolean         @default(false) @map("is_owner")
  isActive        Boolean         @default(true) @map("is_active")
  permissions     Json            @default("[]") // Array of granted permission strings (PRD §4.1/4.2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bills           Bill[]
  stockMovements  StockMovement[]
  expenses        Expense[]

  @@index([shopId])
  @@map("users")
}

model Product {
  id                  String          @id @default(uuid())
  shopId              String          @map("shop_id")
  name                String
  description         String?
  category            String?
  unit                String          @default("piece") // piece, packet, bottle, kg, litre (PRD §5.2)
  purchaseCost        Decimal         @default(0.0) @map("purchase_cost") @db.Decimal(12, 2)
  sellingPrice        Decimal         @default(0.0) @map("selling_price") @db.Decimal(12, 2)
  currentStock        Decimal         @default(0.0) @map("current_stock") @db.Decimal(12, 3)
  lowStockThreshold   Decimal         @default(5.0) @map("low_stock_threshold") @db.Decimal(12, 3)
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  shop                Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  billItems           BillItem[]
  stockMovements      StockMovement[]
  lowStockAlerts      LowStockAlert[]

  @@index([shopId, isActive])
  @@index([shopId, name])
  @@map("products")
}

model Bill {
  id                    String          @id @default(uuid())
  shopId                String          @map("shop_id")
  staffId               String          @map("staff_id")
  billNumber            String          @map("bill_number") // Unique per shop, e.g. BILL-YYYYMMDD-XXXX
  idempotencyKey        String?         @unique @map("idempotency_key") // PRD §9.3 & §10.4 prevents duplicate bill/stock deduction
  subtotal              Decimal         @db.Decimal(12, 2)
  discountAmount        Decimal         @default(0.0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount             Decimal         @default(0.0) @map("tax_amount") @db.Decimal(12, 2)
  finalTotal            Decimal         @db.Decimal(12, 2) @map("final_total")
  totalCostBasis        Decimal         @default(0.0) @map("total_cost_basis") @db.Decimal(12, 2) // PRD §5.5 Cost snapshot for profit
  estimatedGrossProfit  Decimal         @default(0.0) @map("estimated_gross_profit") @db.Decimal(12, 2) // PRD §5.5 & §8
  status                String          @default("COMPLETED") // COMPLETED, VOIDED (PRD §10.2)
  reprintCount          Int             @default(0) @map("reprint_count") // PRD §5.3 Reprint indication
  notes                 String?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  shop                  Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff                 User            @relation(fields: [staffId], references: [id])
  items                 BillItem[]
  stockMovements        StockMovement[]

  @@unique([shopId, billNumber])
  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@map("bills")
}

model BillItem {
  id                   String   @id @default(uuid())
  billId               String   @map("bill_id")
  productId            String   @map("product_id")
  productNameSnapshot  String   @map("product_name_snapshot") // PRD §10.1 Immutable line snapshot
  unitSnapshot         String   @map("unit_snapshot")
  quantity             Decimal  @db.Decimal(12, 3)
  unitPriceSnapshot    Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  unitCostSnapshot     Decimal  @map("unit_cost_snapshot") @db.Decimal(12, 2)
  lineTotal            Decimal  @map("line_total") @db.Decimal(12, 2)
  lineProfit           Decimal  @map("line_profit") @db.Decimal(12, 2)

  bill                 Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([productId])
  @@map("bill_items")
}

model StockMovement {
  id              String    @id @default(uuid())
  shopId          String    @map("shop_id")
  productId       String    @map("product_id")
  userId          String    @map("user_id") // Authorized staff who made the adjustment (PRD §10.1)
  billId          String?   @map("bill_id") // Linked bill if deduction from sale
  movementType    String    @map("movement_type") // SALE, OPENING_STOCK, ADJUSTMENT, RESTOCK, CORRECTION, DAMAGED
  quantityChange  Decimal   @map("quantity_change") @db.Decimal(12, 3) // Negative for sale/damage, positive for restock
  previousStock   Decimal   @map("previous_stock") @db.Decimal(12, 3)
  newStock        Decimal   @map("new_stock") @db.Decimal(12, 3)
  reason          String?   // Mandatory for manual adjustments (PRD §5.2)
  createdAt       DateTime  @default(now()) @map("created_at")

  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id])
  bill            Bill?     @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

model LowStockAlert {
  id                    String    @id @default(uuid())
  shopId                String    @map("shop_id")
  productId             String    @map("product_id")
  currentStockSnapshot  Decimal   @map("current_stock_snapshot") @db.Decimal(12, 3)
  thresholdSnapshot     Decimal   @map("threshold_snapshot") @db.Decimal(12, 3)
  status                String    @default("ACTIVE") // ACTIVE, RESOLVED, ACKNOWLEDGED (PRD §5.6 single active alert)
  triggeredAt           DateTime  @default(now()) @map("triggered_at")
  resolvedAt            DateTime? @map("resolved_at")

  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([productId, status])
  @@map("low_stock_alerts")
}

model Expense {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  userId      String   @map("user_id")
  title       String   // e.g. "Shop Rent - Nov", "Electricity", "Packaging boxes"
  category    String   @default("GENERAL") // RENT, UTILITY, PACKAGING, MAINTENANCE, GENERAL (PRD §5.7)
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now()) @map("expense_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([shopId, expenseDate])
  @@map("expenses")
}

