// SQLite development/local schema for instant zero-dependency execution
// Mirrors the production PostgreSQL schema (PRD v0.2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id              String          @id @default(uuid())
  name            String
  address         String?
  phone           String?
  currency        String          @default("₹")
  taxPercentage   Decimal         @default(0.0) @map("tax_percentage")
  receiptHeader   String?         @map("receipt_header")
  receiptFooter   String?         @map("receipt_footer")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  users           User[]
  products        Product[]
  bills           Bill[]
  stockMovements  StockMovement[]
  lowStockAlerts  LowStockAlert[]
  expenses        Expense[]

  @@map("shops")
}

model User {
  id              String          @id @default(uuid())
  shopId          String          @map("shop_id")
  fullName        String          @map("full_name")
  username        String          @unique
  passwordHash    String          @map("password_hash")
  isOwner         Boolean         @default(false) @map("is_owner")
  isActive        Boolean         @default(true) @map("is_active")
  permissions     String          @default("[]") // JSON string of granted permission codes
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  shop            Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bills           Bill[]
  stockMovements  StockMovement[]
  expenses        Expense[]

  @@index([shopId])
  @@map("users")
}

model Product {
  id                  String          @id @default(uuid())
  shopId              String          @map("shop_id")
  name                String
  description         String?
  category            String?
  unit                String          @default("piece")
  purchaseCost        Decimal         @default(0.0) @map("purchase_cost")
  sellingPrice        Decimal         @default(0.0) @map("selling_price")
  currentStock        Decimal         @default(0.0) @map("current_stock")
  lowStockThreshold   Decimal         @default(5.0) @map("low_stock_threshold")
  isActive            Boolean         @default(true) @map("is_active")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  shop                Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  billItems           BillItem[]
  stockMovements      StockMovement[]
  lowStockAlerts      LowStockAlert[]

  @@index([shopId, isActive])
  @@index([shopId, name])
  @@map("products")
}

model Bill {
  id                    String          @id @default(uuid())
  shopId                String          @map("shop_id")
  staffId               String          @map("staff_id")
  billNumber            String          @map("bill_number")
  idempotencyKey        String?         @unique @map("idempotency_key")
  subtotal              Decimal
  discountAmount        Decimal         @default(0.0) @map("discount_amount")
  taxAmount             Decimal         @default(0.0) @map("tax_amount")
  finalTotal            Decimal         @map("final_total")
  totalCostBasis        Decimal         @default(0.0) @map("total_cost_basis")
  estimatedGrossProfit  Decimal         @default(0.0) @map("estimated_gross_profit")
  status                String          @default("COMPLETED")
  reprintCount          Int             @default(0) @map("reprint_count")
  notes                 String?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  shop                  Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff                 User            @relation(fields: [staffId], references: [id])
  items                 BillItem[]
  stockMovements        StockMovement[]

  @@unique([shopId, billNumber])
  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@map("bills")
}

model BillItem {
  id                   String   @id @default(uuid())
  billId               String   @map("bill_id")
  productId            String   @map("product_id")
  productNameSnapshot  String   @map("product_name_snapshot")
  unitSnapshot         String   @map("unit_snapshot")
  quantity             Decimal
  unitPriceSnapshot    Decimal  @map("unit_price_snapshot")
  unitCostSnapshot     Decimal  @map("unit_cost_snapshot")
  lineTotal            Decimal  @map("line_total")
  lineProfit           Decimal  @map("line_profit")

  bill                 Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id])

  @@index([billId])
  @@index([productId])
  @@map("bill_items")
}

model StockMovement {
  id              String    @id @default(uuid())
  shopId          String    @map("shop_id")
  productId       String    @map("product_id")
  userId          String    @map("user_id")
  billId          String?   @map("bill_id")
  movementType    String    @map("movement_type")
  quantityChange  Decimal   @map("quantity_change")
  previousStock   Decimal   @map("previous_stock")
  newStock        Decimal   @map("new_stock")
  reason          String?
  createdAt       DateTime  @default(now()) @map("created_at")

  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id])
  bill            Bill?     @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}

model LowStockAlert {
  id                    String    @id @default(uuid())
  shopId                String    @map("shop_id")
  productId             String    @map("product_id")
  currentStockSnapshot  Decimal   @map("current_stock_snapshot")
  thresholdSnapshot     Decimal   @map("threshold_snapshot")
  status                String    @default("ACTIVE")
  triggeredAt           DateTime  @default(now()) @map("triggered_at")
  resolvedAt            DateTime? @map("resolved_at")

  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([productId, status])
  @@map("low_stock_alerts")
}

model Expense {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  userId      String   @map("user_id")
  title       String
  category    String   @default("GENERAL")
  amount      Decimal
  expenseDate DateTime @default(now()) @map("expense_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([shopId, expenseDate])
  @@map("expenses")
}

